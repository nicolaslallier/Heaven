# Copier en « .env » à côté de docker-compose.yml, puis adapter.
# Dans Portainer, ces mêmes clés se saisissent dans « Environment variables ».

# --- Ce qui est sauvegardé ---------------------------------------------------
# Répertoire hôte monté (en lecture seule) sur /sources dans le conteneur.
HEAVEN_SOURCES_PATH=/srv
# Sources vues du conteneur ; plusieurs valeurs séparées par « : » ou « , ».
HEAVEN_SOURCES=/sources
HEAVEN_EXCLUDES=*.tmp,__pycache__,node_modules,.venv

# --- Où atterrissent les sauvegardes ----------------------------------------
# Volume Docker nommé par défaut ; mettre un chemin hôte (/mnt/nas/heaven)
# pour écrire ailleurs — idéalement un autre disque que les sources.
HEAVEN_REPOSITORY_PATH=heaven-repository

# --- Quand ------------------------------------------------------------------
# Heure fixe (« 02:30 »), plusieurs heures (« 02:30,14:00 ») ou intervalle (« 6h »).
HEAVEN_SCHEDULE=02:30
HEAVEN_TAG=portainer
# Vérification d'intégrité complète tous les N cycles (0 : jamais).
HEAVEN_VERIFY_EVERY=7
TZ=Europe/Paris

# --- Combien d'instantanés garder -------------------------------------------
HEAVEN_KEEP_LAST=7
HEAVEN_KEEP_DAILY=7
HEAVEN_KEEP_WEEKLY=4
HEAVEN_KEEP_MONTHLY=6

# --- Image ------------------------------------------------------------------
# Utilisée telle quelle par deploy/portainer/stack.yml ; docker-compose.yml
# construit cette image depuis les sources si elle est absente.
HEAVEN_IMAGE=ghcr.io/nicolaslallier/heaven:latest

# --- Déploiement par Portainer ----------------------------------------------
# Ces clés ne vont PAS dans .env : .env est remis tel quel à Portainer comme
# environnement de la pile, et chacune de ces deux-là est un jeton privilégié.
# Chacune a son propre fichier, ignoré par git.
#
# .portainer.env — clé d'API Portainer (My account → Access tokens), utilisée
# par « make deploy ». Root sur le démon Docker : en CI, elle est un *secret*
# du dépôt (PORTAINER_API_KEY), jamais une variable.
#   PORTAINER_API_KEY=change-me
# Facultatif, si Portainer n'est pas celui de la pile Infra :
#   PORTAINER_URL=https://portainer:9443
#   PORTAINER_NETWORK=infra-net
#
# .runner.env — PAT autorisé à enregistrer des runners, pour « make runner-up ».
#   GH_RUNNER_TOKEN=change-me
# Répertoire de travail du runner : un chemin hôte, monté au même chemin.
#   HEAVEN_RUNNER_WORKDIR=/srv/heaven-runner/_work
